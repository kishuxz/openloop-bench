{
  "name": "openloop-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A labeled benchmark for detecting open loops in real founder messaging, including code-mixed Hinglish/Tanglish.",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "pnpm --filter @openloop-bench/corpus run validate",
    "stats": "pnpm --filter @openloop-bench/corpus run stats",
    "stats:check": "pnpm --filter @openloop-bench/corpus run stats:check",
    "stats:by-batch": "pnpm --filter @openloop-bench/corpus run stats:by-batch",
    "separability": "pnpm --filter @openloop-bench/corpus run separability",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate && pnpm stats:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
